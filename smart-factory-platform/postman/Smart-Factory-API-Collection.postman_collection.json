    {
      "name": "01 - Auth and users",
      "description": "Authentication and user-management endpoints.",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/v1/users",
            "description": "Creates a test account. Use a unique username; the collection generates one in pre-request script.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"testUsername\", \"sf_api_\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201 || pm.response.code === 200) { try { const j=pm.response.json(); if(j.username) pm.collectionVariables.set(\"testUsername\", j.username); } catch(e){} }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/v1/auth/login",
            "description": "Saves token as collection variable jwt if login succeeds.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is successful\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
                  "try { const j=pm.response.json(); if (j.token) { pm.collectionVariables.set(\"jwt\", j.token); } } catch(e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "List users - requires authorization if configured",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/v1/users",
            "description": "The current code may only expose user creation. If this returns 404, no list-users endpoint is implemented."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Request returned a recognizable HTTP response\", function () { pm.expect(pm.response.code).to.be.within(200, 599); });"
                ]
              }
            }
          ]
        }
      ]
    },
