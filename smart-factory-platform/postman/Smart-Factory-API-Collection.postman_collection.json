    {
      "name": "00 - Health checks (all services)",
      "description": "Diagnostic checks for every service. Review response body and status; accepted statuses are diagnostic only, not a pass signal for unhealthy/disabled endpoints.",
      "item": [
        {
          "name": "Auth Service - actuator health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/actuator/health",
            "description": "Diagnostic health check. A 404 means actuator health is not exposed/installed; 401/403 means security protects it; 503 means dependency health is DOWN. Investigate rather than treating these as healthy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health endpoint responds (200 expected when actuator health is exposed)\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 401, 403, 404, 503]); });"
                ]
              }
            }
          ]
        },
        {
