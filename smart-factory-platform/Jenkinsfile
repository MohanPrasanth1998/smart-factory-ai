
pipeline {
    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'GHCR_OWNER',
            defaultValue: 'mohanprasanth1998',
            description: 'GitHub Container Registry owner (lowercase)'
        )

        booleanParam(
            name: 'PUBLISH_IMAGES',
            defaultValue: false,
            description: 'Build and publish Docker images to GHCR'
        )

        choice(
            name: 'DEPLOY_TARGET',
            choices: ['none', 'qa'],
            description: 'Deployment target'
        )
    }

    environment {
        REGISTRY = 'ghcr.io'
        IMAGE_PREFIX = 'ghcr.io/${GHCR_OWNER}'
        MYSQL_HOST = 'host.docker.internal'
        MYSQL_PORT = '3306'
    }

    stages {

        stage('Verify build tools') {
            steps {
                sh '''
                    set -e

                    echo "Checking Java..."
                    java -version

                    echo "Checking Maven..."
                    mvn -version

                    echo "Checking Docker..."
                    docker version

                    echo "Checking Docker Compose..."
                    docker compose version
                '''
            }
        }

        stage('Maven verify all non-AI services') {
            steps {
                dir('smart-factory-platform') {
                    script {

                        /*
                         * Auth Service database credentials.
                         *
                         * Jenkins credential ID:
                         * smart-factory-mysql-password
                         *
                         * Credential type: Secret text
                         * Secret: password for MySQL user auth_ci
                         */

                        withCredentials([
                            string(
                                credentialsId: 'smart-factory-mysql-password',
                                variable: 'MYSQL_PASSWORD'
                            )
                        ]) {
                            withEnv([
                                'SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/smart_factory_auth',
                                'SPRING_DATASOURCE_USERNAME=auth_ci',
                                'SPRING_DATASOURCE_PASSWORD=' + env.MYSQL_PASSWORD
                            ]) {
                                sh '''
                                    set -e
                                    echo "Verifying Auth Service..."

                                    mvn -B \
                                        -f services/auth/auth-service/pom.xml \
                                        verify
                                '''
                            }
                        }

                        /*
                         * Verify other non-AI services.
                         * Each service must have its own database
                         * configuration if integration tests require a DB.
                         */

                        def servicePoms = [
                            'services/factory/factory-service/pom.xml',
                            'services/gateway/api-gateway/pom.xml'
                        ]

                        for (pom in servicePoms) {
                            if (fileExists(pom)) {
                                echo "Verifying ${pom}"
                                sh "mvn -B -f '${pom}' verify"
                            } else {
                                echo "Skipping missing POM: ${pom}"
                            }
                        }
                    }
                }
            }
        }

        stage('Validate Compose files') {
            steps {
                dir('smart-factory-platform') {
                    script {
                        def composeFiles = [
                            'docker-compose.yml',
                            'docker-compose.yaml',
                            'compose.yml',
                            'compose.yaml'
                        ]

                        def composeFile = composeFiles.find {
                            fileExists(it)
                        }

                        if (composeFile) {
                            sh "docker compose -f '${composeFile}' config -q"
                            echo "Compose validation passed: ${composeFile}"
                        } else {
                            echo 'No Compose file found at the project root; skipping validation.'
                        }
                    }
                }
            }
        }

        stage('Build and publish multi-arch images to GHCR') {
            when {
                expression {
                    return params.PUBLISH_IMAGES
                }
            }

            steps {
                dir('smart-factory-platform') {
                    script {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'ghcr-credentials',
                                usernameVariable: 'GHCR_USER',
                                passwordVariable: 'GHCR_TOKEN'
                            )
                        ]) {
                            sh '''
                                set -e

                                echo "$GHCR_TOKEN" | docker login ghcr.io \
                                    -u "$GHCR_USER" --password-stdin

                                echo "GHCR login successful."
                                echo "Docker image build commands are not configured yet."
                                echo "Add docker buildx build commands for the actual service Dockerfiles."

                                docker logout ghcr.io
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy QA') {
            when {
                expression {
                    return params.DEPLOY_TARGET == 'qa'
                }
            }

            steps {
                dir('smart-factory-platform') {
                    sh '''
                        set -e
                        echo "QA deployment selected."
                        echo "QA deployment commands are not configured yet."
                        echo "Configure and validate the QA environment before deployment."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Review the stage logs above.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
