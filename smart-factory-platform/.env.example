# Copy to .env and replace placeholders with local values

MYSQL_ROOT_PASSWORD=replace_with_your_local_mysql_password
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace_with_your_local_mysql_password

TELEMETRY_DB_USERNAME=replace_with_existing_postgres_username
TELEMETRY_DB_PASSWORD=replace_with_existing_postgres_password

SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434
SPRING_AI_OLLAMA_CHAT_MODEL=llama3.2
