
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME = 'smart-factory/factory-service:local'
        PROJECT_DIR = 'smart-factory-platform'
        FACTORY_DIR = 'smart-factory-platform/services/factory'
    }

    stages {

        stage('Verify Build Tools') {
            steps {
                sh '''
                    set -eu

                    echo "===== Java ====="
                    java -version

                    echo "===== Git ====="
                    git --version

                    echo "===== Docker ====="
                    docker version

                    echo "===== Maven ====="
                    if command -v mvn >/dev/null 2>&1; then
                        mvn -version
                    else
                        echo "System Maven unavailable; checking Maven Wrapper."
                    fi
                '''
            }
        }

        stage('Locate Factory Service') {
            steps {
                script {
                    if (!fileExists("${env.FACTORY_DIR}/pom.xml")) {
                        error("Factory Service pom.xml not found: ${env.FACTORY_DIR}/pom.xml")
                    }

                    if (!fileExists("${env.FACTORY_DIR}/Dockerfile")) {
                        error("Factory Service Dockerfile not found: ${env.FACTORY_DIR}/Dockerfile")
                    }

                    echo "Factory Service directory: ${env.FACTORY_DIR}"
                }
            }
        }

        stage('Maven Build and Tests') {
            steps {
                withEnv([
                    'SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/smart_factory'
                ]) {
                    script {
                        if (fileExists("${env.FACTORY_DIR}/mvnw")) {
                            dir("${env.FACTORY_DIR}") {
                                sh '''
                                    set -eu
                                    chmod +x ./mvnw
                                    ./mvnw -B clean verify
                                '''
                            }
                        } else if (fileExists("${env.PROJECT_DIR}/mvnw")) {
                            dir("${env.PROJECT_DIR}") {
                                sh '''
                                    set -eu
                                    chmod +x ./mvnw
                                    ./mvnw -B -f services/factory/pom.xml clean verify
                                '''
                            }
                        } else if (fileExists('mvnw')) {
                            sh '''
                                set -eu
                                chmod +x ./mvnw
                                ./mvnw -B -f \
                                    smart-factory-platform/services/factory/pom.xml \
                                    clean verify
                            '''
                        } else {
                            sh '''
                                set -eu
                                mvn -B -f \
                                    smart-factory-platform/services/factory/pom.xml \
                                    clean verify
                            '''
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu

                    echo "Building Factory Service Docker image..."

                    docker build \
                        -t "$IMAGE_NAME" \
                        -f "$FACTORY_DIR/Dockerfile" \
                        "$FACTORY_DIR"
                '''
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh '''
                    set -eu

                    echo "Verifying Docker image..."

                    docker image inspect "$IMAGE_NAME" >/dev/null
                    docker image ls "$IMAGE_NAME"

                    echo "Factory Service Docker image verified."
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Factory Service CI pipeline completed.'
        }

        failure {
            echo 'FAILURE: Factory Service CI pipeline failed.'
            echo 'Open Console Output and inspect the first failing stage.'
        }

        always {
            echo 'Factory Service CI pipeline finished.'
        }
    }
}
