
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        IMAGE_NAME = 'smart-factory/factory-service:local'
        PROJECT_DIR = 'smart-factory-platform'
        FACTORY_DIR = 'smart-factory-platform/services/factory'

        QA_CONTAINER = 'factory-service-qa'
        QA_PORT = '7072'
        DOCKER_NETWORK = 'smart-factory-platform_default'
        JWT_VOLUME = 'smart-factory-platform_jwt_keys'
        QA_DATABASE = 'smart_factory_qa'
    }

    stages {

        stage('Verify Build Tools') {
            steps {
                sh '''
                    set -eu

                    echo "===== Java ====="
                    java -version

                    echo "===== Git ====="
                    git --version

                    echo "===== Docker ====="
                    docker version

                    echo "===== HTTP client ====="
                    command -v curl

                    echo "===== Maven ====="
                    if command -v mvn >/dev/null 2>&1; then
                        mvn -version
                    else
                        echo "System Maven unavailable; checking Maven Wrapper."
                    fi
                '''
            }
        }

        stage('Locate Factory Service') {
            steps {
                script {
                    if (!fileExists("${env.FACTORY_DIR}/pom.xml")) {
                        error(
                            "Factory Service pom.xml not found: " +
                            "${env.FACTORY_DIR}/pom.xml"
                        )
                    }

                    if (!fileExists("${env.FACTORY_DIR}/Dockerfile")) {
                        error(
                            "Factory Service Dockerfile not found: " +
                            "${env.FACTORY_DIR}/Dockerfile"
                        )
                    }

                    echo "Factory Service directory: ${env.FACTORY_DIR}"
                }
            }
        }

        stage('Maven Build and Tests') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'smart-factory-mysql-root',
                        usernameVariable: 'QA_DB_USERNAME',
                        passwordVariable: 'QA_DB_PASSWORD'
                    )
                ]) {
                    script {
                        if (fileExists("${env.FACTORY_DIR}/mvnw")) {
                            dir("${env.FACTORY_DIR}") {
                                sh '''
                                    set -eu

                                    export SPRING_DATASOURCE_URL="jdbc:mysql://host.docker.internal:3306/smart_factory"
                                    export SPRING_DATASOURCE_USERNAME="$QA_DB_USERNAME"
                                    export SPRING_DATASOURCE_PASSWORD="$QA_DB_PASSWORD"

                                    chmod +x ./mvnw
                                    ./mvnw -B clean verify
                                '''
                            }
                        } else if (fileExists("${env.PROJECT_DIR}/mvnw")) {
                            dir("${env.PROJECT_DIR}") {
                                sh '''
                                    set -eu

                                    export SPRING_DATASOURCE_URL="jdbc:mysql://host.docker.internal:3306/smart_factory"
                                    export SPRING_DATASOURCE_USERNAME="$QA_DB_USERNAME"
                                    export SPRING_DATASOURCE_PASSWORD="$QA_DB_PASSWORD"

                                    chmod +x ./mvnw
                                    ./mvnw -B -f services/factory/pom.xml clean verify
                                '''
                            }
                        } else if (fileExists('mvnw')) {
                            sh '''
                                set -eu

                                export SPRING_DATASOURCE_URL="jdbc:mysql://host.docker.internal:3306/smart_factory"
                                export SPRING_DATASOURCE_USERNAME="$QA_DB_USERNAME"
                                export SPRING_DATASOURCE_PASSWORD="$QA_DB_PASSWORD"

                                chmod +x ./mvnw
                                ./mvnw -B -f \
                                    smart-factory-platform/services/factory/pom.xml \
                                    clean verify
                            '''
                        } else {
                            sh '''
                                set -eu

                                export SPRING_DATASOURCE_URL="jdbc:mysql://host.docker.internal:3306/smart_factory"
                                export SPRING_DATASOURCE_USERNAME="$QA_DB_USERNAME"
                                export SPRING_DATASOURCE_PASSWORD="$QA_DB_PASSWORD"

                                mvn -B -f \
                                    smart-factory-platform/services/factory/pom.xml \
                                    clean verify
                            '''
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu

                    echo "Building Factory Service image..."

                    docker build \
                        -t "$IMAGE_NAME" \
                        -f "$FACTORY_DIR/Dockerfile" \
                        "$FACTORY_DIR"

                    docker image inspect "$IMAGE_NAME" >/dev/null

                    echo "Factory Service image built successfully."
                '''
            }
        }

        stage('Check QA Prerequisites') {
            steps {
                sh '''
                    set -eu

                    echo "Checking QA deployment prerequisites..."

                    docker network inspect "$DOCKER_NETWORK" >/dev/null
                    docker volume inspect "$JWT_VOLUME" >/dev/null

                    if docker ps --format '{{.Names}}' | grep -Fx "$QA_CONTAINER"; then
                        echo "An existing QA container is running and will be replaced."
                    fi

                    echo "QA network and JWT volume are available."
                '''
            }
        }

        stage('Deploy Factory Service QA') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'smart-factory-mysql-root',
                        usernameVariable: 'QA_DB_USERNAME',
                        passwordVariable: 'QA_DB_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu

                        echo "Deploying Factory Service QA on port $QA_PORT..."

                        # Remove only our dedicated QA container.
                        docker rm -f "$QA_CONTAINER" 2>/dev/null || true

                        docker run -d \
                            --name "$QA_CONTAINER" \
                            --restart unless-stopped \
                            --network "$DOCKER_NETWORK" \
                            -p "${QA_PORT}:7070" \
                            -e SERVER_PORT=7070 \
                            -e SPRING_DATASOURCE_URL="jdbc:mysql://mysql:3306/${QA_DATABASE}" \
                            -e SPRING_DATASOURCE_USERNAME="$QA_DB_USERNAME" \
                            -e SPRING_DATASOURCE_PASSWORD="$QA_DB_PASSWORD" \
                            -e SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_PUBLIC_KEY_LOCATION=file:/keys/jwt-public.pem \
                            -v "${JWT_VOLUME}:/keys:ro" \
                            "$IMAGE_NAME"

                        echo "QA container created."
                    '''
                }
            }
        }

        stage('Verify Factory Service QA Health') {
            steps {
                sh '''
                    set -eu

                    echo "Waiting for Factory Service QA health..."

                    for attempt in $(seq 1 30); do
                        if curl --fail --silent --show-error \
                            "http://host.docker.internal:${QA_PORT}/actuator/health" \
                            -o /tmp/factory-qa-health.json; then

                            cat /tmp/factory-qa-health.json
                            echo "QA health check passed."
                            exit 0
                        fi

                        echo "Attempt $attempt/30: QA not healthy yet."
                        sleep 5
                    done

                    echo "QA health check failed."
                    echo "Recent container logs:"

                    docker logs --tail 100 "$QA_CONTAINER" || true

                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Factory Service CI and QA deployment completed.'
            echo 'Existing Factory Service on port 7070 was not replaced.'
            echo 'QA endpoint: http://localhost:7072/actuator/health'
        }

        failure {
            echo 'FAILURE: Factory Service CI/CD pipeline failed.'
            echo 'Check the first failing stage in Console Output.'
            echo 'The existing Factory Service on port 7070 was not replaced.'
        }

        always {
            echo 'Factory Service CI/CD pipeline finished.'
        }
    }
}
